# Real values live in ~/containers/website/.env on the server, never in git.
# DB_PASSWORD must be hex/URL-safe: openssl rand -hex 24
DB_PASSWORD=
# openssl rand -hex 32
# Admin sessions are signed with this and last 12 hours; there is no server-side
# session store, so rotating this value is how you end every session at once.
SESSION_SECRET=
# npm run admin:hash -- 'your password'
ADMIN_PASSWORD_HASH=
