generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Experience, Societies and Volunteering render identically, so they share a
// model and differ only by section.
enum TimelineSection {
  EXPERIENCE
  SOCIETY
  VOLUNTEERING
}

model TimelineEntry {
  id          String          @id @default(cuid())
  section     TimelineSection
  period      String
  role        String
  org         String
  description String
  tags        String[]
  position    Int             @default(0)

  @@index([section, position])
}

model Production {
  id          String   @id @default(cuid())
  slug        String   @unique
  event       String
  date        String
  year        Int
  role        String
  description String
  tech        String[]
  photos      String[]
  position    Int      @default(0)

  @@index([position])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  tech        String[]
  github      String?
  demo        String?
  position    Int      @default(0)

  @@index([position])
}

enum SkillSection {
  HOME
  PRODUCTION
}

model SkillGroup {
  id       String       @id @default(cuid())
  section  SkillSection @default(HOME)
  category String
  skills   String[]
  position Int          @default(0)

  @@index([section, position])
}

// "Current organisations" on /production
model ProductionOrg {
  id       String   @id @default(cuid())
  org      String
  period   String
  roles    String[]
  position Int      @default(0)

  @@index([position])
}

// The scrolling logo strip on /production. No image shows the name as text.
model Logo {
  id       String  @id @default(cuid())
  name     String
  img      String?
  invert   Boolean @default(false)
  position Int     @default(0)

  @@index([position])
}

// /secsoc ballot preferences, in preference order
model Position {
  id       String @id @default(cuid())
  title    String
  body     String
  position Int    @default(0)

  @@index([position])
}

// /secsoc background photos
model Photo {
  id       String @id @default(cuid())
  src      String
  caption  String
  position Int    @default(0)

  @@index([position])
}

model Course {
  id       String @id @default(cuid())
  code     String
  name     String
  grade    Int
  position Int    @default(0)

  @@index([position])
}

enum FactSection {
  ABOUT
  EDUCATION
}

model Fact {
  id       String      @id @default(cuid())
  section  FactSection
  label    String
  value    String
  position Int         @default(0)

  @@index([section, position])
}

// Section text and page section order, keyed as described in src/lib/pages.js.
model Setting {
  key   String @id
  value String
}
